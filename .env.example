# Which repository the /admin editor reads and writes. These are baked into the
# build, so change them here (or as GitHub Actions repository variables) rather
# than in the code. They are public values — not secrets.
NEXT_PUBLIC_GITHUB_OWNER=alfredsilvertonai
NEXT_PUBLIC_GITHUB_REPO=ko-volleyball-web
NEXT_PUBLIC_GITHUB_BRANCH=main

# Only for a GitHub Pages project site served from a sub-path, e.g.
# https://<user>.github.io/ko-volleyball-web  ->  /ko-volleyball-web
# Leave empty for a custom domain.
NEXT_PUBLIC_BASE_PATH=
