# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the example is documentation, not a secret: it only lists the public
# repo coordinates the /admin editor is built with.
!.env.example

# vercel
.vercel

# Photo drops for the gallery: ~36 MB of full-resolution originals that only
# scripts/build-gallery.mjs ever reads. What the site serves is the WebP
# derivatives under public/images/gallery/, and those *are* committed — so
# neither a build nor a deploy touches this folder, and carrying it would add
# 36 MB to this repo and to the production mirror forever.
# This means git is NOT a backup of the originals. Keep them somewhere else.
/content/images/

# typescript
*.tsbuildinfo
next-env.d.ts
